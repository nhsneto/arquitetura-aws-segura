                <mxCell id="e11" edge="1" parent="1" source="vpc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E7157B;fontSize=11;fontStyle=1;fontColor=#E7157B;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.17;entryX=0;entryY=0.5;" target="obs" value="Logs de aplicação, ALB/WAF, métricas e auditoria">

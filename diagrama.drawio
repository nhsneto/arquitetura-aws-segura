                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="apiA_to_interface_endpoint" edge="1" parent="1" source="apiA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C4FFF;fontSize=10;fontStyle=1;fontColor=#8C4FFF;labelBackgroundColor=#FFFFFF;dashed=0;" target="ife" value="HTTPS 443">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="r3eHg70qUuGGFTRyDyxq-2" edge="1" parent="1" source="gwe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7AA116;fontSize=11;fontStyle=1;fontColor=#7AA116;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;" target="ife" value="">
                    <mxGeometry relative="1" as="geometry">
